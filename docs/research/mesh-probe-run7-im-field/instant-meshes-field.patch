 #include "normal.h"
 #include "extract.h"
 #include "bvh.h"
+#include <fstream>
+#include <unordered_map>
+
+/* Fork: external constraint field. Text file: a count n, then n records
+     x y z   qx qy qz qw   ox oy oz ow   s
+   (q: tangent direction + weight in [0,1] blended into the orientation solve;
+    o: a point the lattice line along q must pass through + weight, as Instant Meshes' boundary
+    constraints use it; s: target edge length at the point, <= 0 for the global scale).
+   Each solver vertex takes the nearest record (uniform-grid lookup), so the records need not
+   match the vertex indexing after subdivision. */
+static void apply_field_file(MultiResolutionHierarchy &mRes, const std::string &path, int rosy, int posy) {
+    std::ifstream is(path);
+    if (!is) throw std::runtime_error("Could not open field file " + path);
+    size_t n; is >> n;
+    std::vector<Float> R(n * 12);
+    for (size_t k = 0; k < n * 12; ++k) is >> R[k];
+    if (!is) throw std::runtime_error("Field file is truncated: " + path);
+    Vector3f lo = Vector3f::Constant(1e30f), hi = Vector3f::Constant(-1e30f);
+    for (size_t r = 0; r < n; ++r) for (int k = 0; k < 3; ++k) { lo[k] = std::min(lo[k], R[r*12+k]); hi[k] = std::max(hi[k], R[r*12+k]); }
+    Float cell = std::max((hi - lo).maxCoeff() / std::cbrt((Float) n) * 1.5f, (Float) 1e-6f);
+    auto key = [&](const Vector3f &p, int dx, int dy, int dz) {
+        int64_t x = (int64_t) std::floor((p.x() - lo.x()) / cell) + dx, y = (int64_t) std::floor((p.y() - lo.y()) / cell) + dy,
+                z = (int64_t) std::floor((p.z() - lo.z()) / cell) + dz;
+        return (x * 73856093) ^ (y * 19349663) ^ (z * 83492791);
+    };
+    std::unordered_multimap<int64_t, uint32_t> grid;
+    for (size_t r = 0; r < n; ++r) grid.emplace(key(Vector3f(R[r*12], R[r*12+1], R[r*12+2]), 0, 0, 0), (uint32_t) r);
+    mRes.clearConstraints();
+    const MatrixXf &V = mRes.V(), &N = mRes.N();
+    VectorXf S0(V.cols()); bool anyS = false;
+    uint32_t nq = 0, no = 0;
+    for (uint32_t i = 0; i < V.cols(); ++i) {
+        Vector3f p = V.col(i); Float best = 1e30f; int64_t br = -1;
+        for (int ring = 1; ring <= 3 && br < 0; ++ring)
+            for (int dx = -ring; dx <= ring; ++dx) for (int dy = -ring; dy <= ring; ++dy) for (int dz = -ring; dz <= ring; ++dz) {
+                auto range = grid.equal_range(key(p, dx, dy, dz));
+                for (auto it = range.first; it != range.second; ++it) {
+                    const Float *q = &R[it->second * 12];
+                    Float d = (Vector3f(q[0], q[1], q[2]) - p).squaredNorm();
+                    if (d < best) { best = d; br = it->second; }
+                }
+            }
+        if (br < 0) { S0[i] = mRes.scale(); continue; }
+        const Float *q = &R[br * 12];
+        Vector3f n_i = N.col(i), cq(q[3], q[4], q[5]);
+        cq -= n_i * n_i.dot(cq);
+        if (q[6] > 0 && cq.squaredNorm() > 1e-12f) {
+            mRes.CQ().col(i) = cq.normalized(); mRes.CQw()[i] = std::min(q[6], (Float) 1); ++nq;
+            if (q[10] > 0) { mRes.CO().col(i) = Vector3f(q[7], q[8], q[9]); mRes.COw()[i] = std::min(q[10], (Float) 1); ++no; }
+        }
+        S0[i] = q[11] > 0 ? q[11] : mRes.scale(); anyS |= q[11] > 0;
+    }
+    mRes.propagateConstraints(rosy, posy);
+    cout << "Field file: " << n << " records, " << nq << " orientation and " << no << " position constraints";
+    if (anyS) {
+        std::vector<VectorXf> &S = mRes.Slevels(); S.clear(); S.push_back(S0);
+        for (int l = 0; l + 1 < mRes.levels(); ++l) {
+            const MatrixXu &up = mRes.toUpper(l); VectorXf next(up.cols());
+            for (uint32_t i = 0; i < up.cols(); ++i)
+                next[i] = up(1, i) == INVALID ? S[l][up(0, i)] : 0.5f * (S[l][up(0, i)] + S[l][up(1, i)]);
+            S.push_back(next);
+        }
+        cout << ", per-vertex scale " << S0.minCoeff() << " .. " << S0.maxCoeff();
+    }
+    cout << endl;
+}
 
